      "seed": 1093961912,
      "version": 1256,
      "versionNonce": 1829601992,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795187692120,
      "link": null,
      "locked": false,
      "text": "TP x PP x DP组合\n就是在前面TPxPP的基础上 扩容为DP份\nDP（数据并行）",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TP x PP x DP组合\n就是在前面TPxPP的基础上 扩容为DP份\nDP（数据并行）",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZxfBmkirhkC3e1mM66jYT",
      "type": "image",
      "x": 389.770751953125,
      "y": 4886.70733904436,
      "width": 653.4559326171875,
      "height": 490.0919494628906,
      "angle": 0,
      "strokeColor": "transparent",
