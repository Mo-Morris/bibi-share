      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "理想情况下 一张卡把一个模型装下了 模型小 1张卡搞定 这个最简单",
      "autoResize": true,
      "lineHeight": 1.25
    },
