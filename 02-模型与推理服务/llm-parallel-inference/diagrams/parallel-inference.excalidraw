    },
    {
      "id": "LqOC144fIA6rVTRC8XqIB",
      "type": "text",
      "x": 479.6195068359375,
      "y": 3929.514558708286,
      "width": 515.7599487304688,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Y",
