      "crop": null
    },
    {
      "id": "we-1HGKf2PnjUkfTLcN9F",
      "type": "text",
      "x": 573.5882568359375,
      "y": 2529.200852289874,
      "width": 574.0279541015625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 1725347512,
      "version": 964,
      "versionNonce": 82446008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795184925237,
      "link": null,
      "locked": false,
      "text": "TP和PP组合可以吗 \n假设一共6层\n先按照PP=2来划分  每张GPU 跑3层\n3层再按照TP=2来划分 每层的1/2在一张卡上\nTPxPP就是需要的卡的数量",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TP和PP组合可以吗 \n假设一共6层\n先按照PP=2来划分  每张GPU 跑3层\n3层再按照TP=2来划分 每层的1/2在一张卡上\nTPxPP就是需要的卡的数量",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EaWt6pB89GNy3qeauGUzM",
      "type": "image",
      "x": 426.7703653971354,
      "y": 3295.566908589617,
      "width": 931.4734903971354,
      "height": 523.9538383483887,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
